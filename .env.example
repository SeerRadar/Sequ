# dotenv config 
DOTENV_CONFIG_QUIET=true

# 登录目标大区：cn = 大陆服，tw = 台服
REGION=cn

# 大陆服
SERVICE_ACCOUNT_ID=12345678
SERVICE_ACCOUNT_PASSWORD=your_password_here

# 台服账
TW_SERVICE_ACCOUNT_ID=
TW_SERVICE_ACCOUNT_PASSWORD=

# 陆服兜底
GAME_SERVER_HOST=175.24.235.221
GAME_SERVER_PORT=1225

# 是否打印发送/接收封包的回调日志（生产环境设为 false 减少日志输出）
LOG_CALLBACKS=true
# 是否记录完整的封包数据
LOG_FULL_PACKET=false
# 忽略不打印日志的命令ID列表 (使用 | 分隔)
IGNORED_CMD_IDS=8002|8015|3452|2004|2001|41228|1002|2002

# 飞书机器人
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_url_here
FEISHU_WEBHOOK_SECRET=your_webhook_secret_here
